   "source": [
    "before_model\n",
    "→ Do something BEFORE LLM call\n",
    "\n",
    "after_model\n",
    "→ Do something AFTER LLM call\n",
    "\n",
    "dynamic_prompt\n",
    "→ Change SYSTEM PROMPT dynamically\n",
    "\n",
    "wrap_model_call\n",
    "→ Control / modify the MODEL CALL itself\n",
